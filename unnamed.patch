-// ═══════════════════════════════════
-// GAMES SCREEN
-// ═══════════════════════════════════
-function getIconHtml(pkg, name, cls) {
-  if (window.GameBooster) {
-    try {
-      const b64 = window.GameBooster.getAppIcon(pkg);
-      if (b64 && b64.length > 0)
-        return `<img src="data:image/png;base64,${b64}" alt="${name}" style="width:100%;height:100%;border-radius:10px;object-fit:cover">`;
-    } catch(e) {}
-  }
-  return name.substring(0, 4).toUpperCase();
-}
