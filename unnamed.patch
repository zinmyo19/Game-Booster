-function openProfileModal(i) { S.profileTarget=i; document.getElementById('profileModal').classList.add('open'); }
-function selectProfile(p) {
-  if (S.profileTarget>=0) { S.games[S.profileTarget].profile=p; }
-  closeModal('profileModal'); renderGames(); persistGames();
-}
