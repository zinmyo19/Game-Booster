-// ═══════════════════════════════════
-// CLOCK
-// ═══════════════════════════════════
-function updateClock() {
-  const n = new Date();
-  let h = n.getHours();
-  const ampm = h >= 12 ? 'PM' : 'AM';
-  h = h % 12 || 12;
-  const m = n.getMinutes().toString().padStart(2,'0');
-  document.getElementById('clockEl').textContent = h + ':' + m + ' ' + ampm;
-}
-updateClock(); setInterval(updateClock, 10000);
-
-// ═══════════════════════════════════
-// LOAD REAL KILL LIST FROM DEVICE
-// ═══════════════════════════════════
-function loadKillListFromDevice() {
-  // Kill list starts EMPTY — user manually adds apps they want to kill
-  // Just verify bridge works
-  if (!window.GameBooster) return;
-  try {
-    const test = JSON.parse(window.GameBooster.getKillableApps());
-    console.log('Bridge OK — ' + test.length + ' apps available to kill');
-  } catch(e) { console.error('loadKillList bridge error:', e); }
-  renderDashKillList();
-  renderKillPreview();
-}
-
-// ═══════════════════════════════════
-// DASHBOARD KILL LIST
-// ═══════════════════════════════════
-function renderDashKillList() {
-  const el = document.getElementById('dashKillList');
-  el.innerHTML = '';
