-    el.innerHTML = '<div class="loading-msg">No apps in kill list</div>'; return;
-  }
-  S.killList.slice(0, 5).forEach(app => {
-    const d = document.createElement('div');
-    d.className = 'app-kill-item';
-    const initials = app.name.substring(0, 3).toUpperCase();
-    d.innerHTML = `
-      <div class="app-kill-icon">${initials}</div>
-      <div class="app-kill-info">
-        <div class="app-kill-name">${app.name}</div>
-        <div class="app-kill-pkg">${app.pkg}</div>
-      </div>
-      <div class="kill-btn" onclick="killOneApp('${app.pkg.replace(/'/g,"\\'")}',this)">✕</div>`;
-    el.appendChild(d);
-  });
-}
-
-function killOneApp(pkg, btn) {
-  const item = btn.closest('.app-kill-item');
-  item.style.transition = 'all .3s ease';
-  item.style.opacity = '0'; item.style.transform = 'translateX(20px)';
-  setTimeout(() => item.remove(), 300);
-  if (window.GameBooster) window.GameBooster.killApp(pkg);
-}
-
-// ═══════════════════════════════════
-// BOOST BUTTONS
-// ═══════════════════════════════════
-function toggleAutoBoost(el) {
-  el.classList.toggle('active'); S.autoBoost = el.classList.contains('active');
-  const s = document.getElementById('boostStatus');
-  s.textContent = S.autoBoost ? '⚡ ACTIVE' : '○  IDLE';
-  s.style.color  = S.autoBoost ? '#00f5ff' : '#4a6080';
-  const t = document.getElementById('autoBoostToggle');
-  if (t) S.autoBoost ? t.classList.add('on') : t.classList.remove('on');
-  if (window.GameBooster) window.GameBooster.setAutoBoost(S.autoBoost);
-}
-
-document.getElementById('boostNowBtn').onclick = function() {
-  this.textContent = '🧹 FREEING RAM...';
-  if (window.GameBooster) window.GameBooster.boostNow();
-  setTimeout(() => { this.textContent = '⚡ BOOST NOW'; }, 3000);
-};
-
-document.getElementById('killAllBtn').onclick = function() {
-  const btn = this; btn.textContent = '💀 KILLING...'; btn.style.opacity = '0.6';
-  if (window.GameBooster) window.GameBooster.killAllApps();
-  setTimeout(() => {
-    btn.textContent = '✅ ALL KILLED'; btn.style.opacity = '1'; btn.style.color = '#00ff88';
-    setTimeout(() => { btn.textContent = '💀 KILL ALL BACKGROUND APPS'; btn.style.color = ''; }, 3000);
-  }, 1500);
-};
