-  if (s === 'games')    renderGames();
-  if (s === 'apps')     renderAppsKillList();
-  if (s === 'settings') { renderKillPreview(); updateShizukuStatus(); }
-  if (s === 'history')  renderHistory();
-  if (s === 'dashboard') renderDashKillList();
-}
